{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvlmedia.github.io/LensWiki/data/schemas/lens.schema.json",
  "title": "LensWiki Lens Record",
  "description": "Schema for a single curated LensWiki cinema lens JSON record.",
  "type": "object",
  "required": ["id", "name", "yearIntroduced"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable lowercase identifier for the lens record."
    },
    "slug": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "designer": {
      "type": "string"
    },
    "yearIntroduced": {
      "type": "integer"
    },
    "yearApproximate": {
      "type": "boolean",
      "default": false
    },
    "productionYears": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "factoryLocation": {
      "type": "string"
    },
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isRehoused": {
      "type": "boolean",
      "default": false,
      "description": "True when this record describes a rehoused lens or rehoused lens family rather than an original cinema lens."
    },
    "importance": {
      "type": "string",
      "enum": ["legendary", "important", "niche", "obscure", "experimental", ""]
    },
    "timelineCategory": {
      "type": "string"
    },
    "era": {
      "type": "string"
    },
    "cardLabel": {
      "type": "string"
    },
    "publicSummary": {
      "type": "string"
    },
    "coverage": {
      "type": "string"
    },
    "formatCoverageNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seriesHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "series": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "yearApproximate": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "focalLengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tStops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closeFocus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focalLengthSpecs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "focalLength": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "maxAperture": {
            "type": "string"
          },
          "apertureRange": {
            "type": "string"
          },
          "closeFocus": {
            "type": "string"
          },
          "minimumMarkedObjectDistance": {
            "type": "string"
          },
          "frontDiameter": {
            "type": "string"
          },
          "donorLens": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "opticalFormula": {
      "type": "string"
    },
    "elements": {
      "type": ["integer", "null"]
    },
    "groups": {
      "type": ["integer", "null"]
    },
    "coating": {
      "type": "string"
    },
    "designFamily": {
      "type": "string"
    },
    "donorLens": {
      "type": "string"
    },
    "rehousingInfo": {
      "type": "string"
    },
    "originalMount": {
      "type": "string"
    },
    "donorMount": {
      "type": "string"
    },
    "rehousingCompany": {
      "type": "string"
    },
    "rehousingGeneration": {
      "type": "string"
    },
    "rehousingNotes": {
      "type": "string"
    },
    "lookSummary": {
      "type": "string"
    },
    "characteristics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "famousUses": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      }
    },
    "youtubeEmbeds": {
      "type": "array",
      "description": "Canonical YouTube sample links. Editors may paste youtu.be, watch, embed or Shorts links; the app normalizes them.",
      "items": {
        "type": "string"
      }
    },
    "imageUrls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedLensIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["verified", "medium", "needs verification", ""]
    },
    "notes": {
      "type": "string"
    },
    "libraryStatus": {
      "type": "string"
    },
    "curationNotes": {
      "type": "string"
    }
  }
}
